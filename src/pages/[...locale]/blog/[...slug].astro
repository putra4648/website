---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { localeMap } from "intlayer";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import BlogPostLayout from "../../../layouts/BlogPostLayout.astro";

dayjs.extend(utc);

export async function getStaticPaths() {
  const pages = (await getCollection("blog")) as CollectionEntry<"blog">[];

  return localeMap(({ locale }) =>
    pages
      .filter((page) => page.data.lang === locale)
      .map((page) => ({
        params: {
          locale,
          slug: page.id.split("/").pop()!.replace(/\.mdx?$/, ""),
        },
        props: page,
      })),
  ).flat();
}

type Props = CollectionEntry<"blog">;
const page = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(page);
const lastModified = dayjs(remarkPluginFrontmatter.lastModified)
    .utc()
    .format("DD MMMM YYYY UTC");

---

<BlogPostLayout
  post={page.data}
  minutesRead={remarkPluginFrontmatter.minutesRead}
  lastModified={lastModified}
>
  <Content />
</BlogPostLayout>
