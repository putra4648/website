---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { localeMap } from "intlayer";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import ArticleLayout from "../../../layouts/ArticlePostLayout.astro";

dayjs.extend(utc);

export async function getStaticPaths() {
  const pages = (await getCollection(
    "article",
  )) as CollectionEntry<"article">[];

  return localeMap(({ locale }) =>
    pages
      .filter((page) => page.data.lang === locale && !page.data.isDraft)
      .map((page) => ({
        params: {
          locale,
          slug: page.id
            .split("/")
            .pop()!
            .replace(/\.mdx?$/, ""),
        },
        props: page,
      })),
  ).flat();
}

type Props = CollectionEntry<"article">;
const page = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(page);
const lastModified = dayjs(remarkPluginFrontmatter.lastModified)
  .utc()
  .format("DD MMMM YYYY UTC");
---

<ArticleLayout
  article={page.data}
  minutesRead={remarkPluginFrontmatter.minutesRead}
  lastModified={lastModified}
>
  <Content />
</ArticleLayout>
