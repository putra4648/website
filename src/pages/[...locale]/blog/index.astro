---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { getIntlayer, getLocalizedUrl, getLocaleFromPath, Locales, type LocalesValues } from "intlayer";
import FormattedDate from "../../../components/FormattedDate.astro";
import Footer from "../../../components/Footer.astro";
import Navbar from "../../../components/Navbar.astro";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
  return [{ params: { locale: Locales.INDONESIAN } }];
}

const posts = (await getCollection("blog"))
  .filter((post) => post.data.lang === Locales.INDONESIAN)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const blog = getIntlayer("blog", locale);
type BlogArticle = { title: string; description: string };
const articles = blog.articles as unknown as Record<string, BlogArticle>;
---

<!doctype html>
<html>
  <body>
    <Navbar />
    <Layout>
      <div class="flex flex-col space-y-4 items-center min-h-[calc(100vh-200px)]">
        <div class="grid md:grid-cols-3 gap-3">
          {posts.map((post) => {
            const slug = post.id.split("/").pop()!.replace(/\.mdx?$/, "");
            const article = articles[slug];
            return (
              <div 
                class="card card-border bg-base-100 shadow-[6px_6px_0_0_rgba(0,0,0,0.2)]
               hover:shadow-[0_4px_0_0_rgba(0,0,0,0.2)]
               active:shadow-none active:translate-y-1.5
               transition-all duration-75"
              >
                <figure>
                  <Image
                    src={`/open-graph/${post.id}.png`}
                    alt={article.title}
                    width={500}
                    height={500}
                  />
                </figure>

                <div class="card-body">
                  <h2 class="card-title flex justify-between">
                    <p class="line-clamp-2">{article.title}</p>
                  </h2>
                  <p class="line-clamp-3">{article.description}</p>
                  <div class="card-actions justify-between items-center">
                    <FormattedDate date={post.data.pubDate} />
                    <a
                      href={getLocalizedUrl(`/blog/${slug}`, locale)}
                      class="btn btn-primary btn-sm gap-2"
                    >
                      {blog.actions.readMore}
                      <Icon name="material-symbols:arrow-forward" />
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </Layout>
    <Footer />
  </body>
</html>
