---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Footer from "../../../components/Footer.astro";
import Layout from "../../../layouts/Layout.astro";
import FormattedDate from "../../../components/FormattedDate.astro";
import Navbar from "../../../components/Navbar.astro";
import type { Page } from "astro";
import Pagination from "../../../components/Pagination.astro";
import { Icon } from "astro-icon/components";
import {
  getIntlayer,
  getLocaleFromPath,
  getLocalizedUrl,
  localeMap,
  type LocalesValues,
} from "intlayer";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter((p) => !p.data.isDraft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return localeMap(({ locale }) => ({
    params: { locale },
    props: {
      posts: posts.filter((post) => post.data.lang === locale),
    },
  }));
}

const { posts } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const blog = getIntlayer("blog", locale);
type BlogArticle = { title: string; description: string };
const articles = blog.articles as unknown as Record<string, BlogArticle>;
const postsByYear = posts.reduce((acc: Record<string, any[]>, post: any) => {
  const year = new Date(post.data.pubDate).getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {});
const sortedYears = Object.keys(postsByYear).sort(
  (a, b) => Number(b) - Number(a),
);
---

<!doctype html>
<html>
  <body>
    <Navbar />
    <Layout>
      <div class="container mx-auto">
        <div class="flex flex-col space-y-5 mt-5">
          <div class="font-bold text-xl">Blogs</div>
          <div class="text-mono">
            {blog.subtitle}
          </div>
          <div class="flex flex-col space-y-8">
            {
              sortedYears.map((year) => (
                <div class="flex flex-col space-y-3">
                  <div>
                    <h2 class="text-lg font-bold">{year}</h2>
                    <hr class="my-1 border-base-300" />
                  </div>

                  <div class="grid md:grid-cols-3 gap-3">
                    {postsByYear[year].map((post: any) => {
                      const slug = post.id
                        .split("/")
                        .pop()!
                        .replace(/\.mdx?$/, "");
                      const article = articles[slug] || {};
                      return (
                        <a
                          href={getLocalizedUrl(`/blog/${post.id}`, locale)}
                          class="card card-border bg-base-100 shadow-[6px_6px_0_0_rgba(0,0,0,0.2)]
                          hover:shadow-[0_4px_0_0_rgba(0,0,0,0.2)]
                          active:shadow-none active:translate-y-1.5
                          transition-all duration-75"
                        >
                          <div class="card-body">
                            <h3 class="card-title flex justify-between">
                              <p class="line-clamp-2">{article.title}</p>
                              <div>
                                <span
                                  class={`fi fi-${post.data.lang == "en" ? "gb" : "id"}`}
                                />
                              </div>
                            </h3>
                            <small class="card-subtitle">
                              <FormattedDate date={post.data.pubDate} />
                            </small>
                          </div>
                        </a>
                      );
                    })}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </Layout>
    <Footer />
  </body>
</html>
