---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Skill from "../../components/Skill.astro";
import WorkTimeline from "../../components/WorkTimeline.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { getLangFromUrl } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";

const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <Layout>
      <div class="container mx-auto">
        <div class="grid md:grid-cols-2 m-5 gap-10">
          <div class="w-full prose">
            <h1>🧑 Halo, Semuanya!</h1>
            <p>
              Saya adalah seorang <span class="text-green-300"
                >Fullstack Software Engineer</span
              > dengan fokus utama pada
              <span class="underline font-bold">sistem backend</span>,
              <span class="underline font-bold">arsitektur modular</span>, dan
              <span class="underline font-bold"
                >pengembangan aplikasi enterprise</span
              >. Saya berspesialisasi dalam membangun sistem yang scalable dan
              mudah dikelola menggunakan framework berbasis Java seperti
              SpringBoot dan Quarkus, yang didukung oleh teknologi frontend
              modern termasuk React, Vue, dan Nuxt.
            </p>
            <p>
              Detail-oriented dalam perancangan sistem, terutama pada pemodelan
              database, alur transaksi, dan optimasi performa. Saya sangat
              menjunjung tinggi clean architecture, pemisahan kepentingan
              (separation of concerns) yang jelas, dan pemeliharaan jangka
              panjang dibandingkan sekadar solusi instan (short-term fixes).
            </p>
            <p>
              Saat ini, saya terus memperdalam keahlian saya dalam
              <span class="underline font-bold">sistem terdistribusi</span>,
              <span class="underline font-bold">integrasi IoT</span>, dan
              <span class="underline font-bold"
                >layanan backend performa tinggi</span
              >
              sambil menghadirkan solusi perangkat lunak yang andal dan efisien untuk
              operasional bisnis di dunia nyata.
            </p>
            <Skill />
          </div>
          <div class="w-full">
            <h2 class="text-xl font-bold mb-10">Pengalaman Kerja</h2>
            <WorkTimeline />
          </div>
          <div class="w-full"></div>
        </div>
      </div>
      <Footer />
    </Layout>
  </body>
</html>
