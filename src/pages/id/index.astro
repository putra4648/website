---
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Project from "../../components/Project.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <Header />
  <main class="container mx-auto p-3 prose my-5">
    <div class="flex flex-col">
      <h1>🧑🚀 Halo, Semuanya!</h1>
      <!-- <h2>Namaku adalah "Putra"</h2> -->
      <p>
        <span class="text-lg font-bold text-red-300"
          >Fullstack Software Engineer</span
        > |
        <span class="text-lg font-bold text-green-300"
          >Spesialis Ekosistem Java & Modern Frontend</span
        >
      </p>
      <p>
        Fullstack Software Engineer yang menjembatani sistem backend Java yang
        kokoh dengan antarmuka modern yang responsif. Berpengalaman dalam
        membangun arsitektur modular, alur DevOps, dan solusi enterprise yang
        siap pakai. Saya membantu organisasi mewujudkan ide menjadi produk
        digital yang andal dan terukur.!
      </p>
      <button class="btn btn-success btn-block">Lihat Resume</button>
      <div class="stats stats-vertical lg:stats-horizontal shadow">
        <div class="stat">
          <div class="stat-title">Pengalaman</div>
          <div class="stat-value">3+ Tahun</div>
          <div class="stat-desc">
            Sebagai Fullstack (termasuk Android Development)
          </div>
        </div>

        <div class="stat">
          <div class="stat-title">Proyek</div>
          <div class="stat-value">5+</div>
          <div class="stat-desc">Dominan proyek internal</div>
        </div>
      </div>
    </div>
  </main>
  <!-- <Project /> -->
  <Footer />
</Layout>
