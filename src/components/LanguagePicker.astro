---
import {
  defaultLocale,
  getLocaleFromPath,
  getLocalizedUrl,
  localeMap,
  type LocalesValues,
} from "intlayer";

const currentLang = (getLocaleFromPath(Astro.url.pathname) ?? defaultLocale) as LocalesValues;
const locales = localeMap(({ locale }) => locale);
const translatePath = (targetLang: LocalesValues) =>
  getLocalizedUrl(Astro.url.pathname, targetLang);
---

<div class="dropdown">
  <div
    tabindex="0"
    role="button"
    class="btn btn-ghost btn-sm rounded-btn uppercase"
  >
    {currentLang.toUpperCase()}
  </div>
  <ul
    tabindex="-1"
    class="menu dropdown-content z-1 p-2 shadow bg-base-100 rounded-box w-32 mt-4"
  >
    {
      locales.map((code) => (
        <li>
          <a
            href={translatePath(code)}
            class={code === currentLang ? "active" : ""}
          >
            {code.toUpperCase()}
          </a>
        </li>
      ))
    }
  </ul>
</div>
