---
import { Icon } from "astro-icon/components";
import SkillList from "./SkillList.astro";
import Timeline from "./Timeline.astro";

const skills = [
    {
        name: "Full-Stack Proficiency & Versatility",
        icon: "material-symbols:code",
        title: "3+ Years of Full-Stack Expertise",
        description: `Proven track record in building end-to-end applications using a modern tech stack, including Golang, Java (Spring Boot), and Nuxt/Vue. I bridge the gap between complex backend architecture and seamless frontend interfaces`,
    },
    {
        name: "Specialized Domain Knowledge",
        icon: "material-symbols:domain",
        title: "Expertise in ERP & Logistics Systems",
        description: `Deeply focused on developing mission-critical systems like ERP (Enterprise Resource Planning) and WMS (Warehouse Management System). I understand the technical and operational complexities of inventory management and business automation`,
    },
    {
        name: "Product-Driven Mindset",
        icon: "material-symbols:manufacturing",
        title: "SaaS & Product Development Focus",
        description: `Beyond just writing code, I have a strong interest in building SaaS products that solve real-world problems. From conceptualizing MVPs to implementing scalable features, I build with a focus on business value and user efficiency.`,
    },
    {
        name: "Entrepreneurial Spirit",
        icon: "material-symbols:rocket-launch",
        title: "Entrepreneurial & Growth-Oriented",
        description: `Passionate about building digital assets and scalable SaaS solutions. I combine technical skills with a business mindset to transform innovative ideas into functional, revenue-generating products`,
    },
];
const timelines = [
    {
        year: "2021",
        title: "Freelance",
        company: "",
        jobdesk: [
            "IoT Development: Developed a high-performance smart home mobile application using Flutter, enabling intuitive control over various IoT devices.",
            "Protocol Integration: Integrated complex IoT communication protocols and REST APIs to enhance system responsiveness and user experience.",
            "Real-time Monitoring: Implemented real-time device status monitoring and automated routines to streamline user interaction.",
        ],
        stack: ["Flutter", "Firebase", "REST API"],
    },
    {
        year: "2023",
        title: "Fullstack Developer",
        company: "PT. Astra Honda Motor",
        jobdesk: [
            "System Modernization: Spearheaded the modernization of legacy Oracle ADF 11g applications, migrating them to modern web and desktop platforms using Spring Boot and frontend technologies.",
            "SQL Optimization: Enhanced system responsiveness by optimizing complex SQL queries (JOINS and UNIONs) to significantly reduce execution time.",
            "Code Quality: Improved long-term maintainability by refactoring legacy codebases, modularizing components, and applying Clean Code principles.",
        ],
        stack: [
            "Spring Boot",
            "jQuery",
            "Oracle ADF",
            "Oracle Database",
            ".NET",
        ],
    },
    {
        year: "2024",
        title: "Fullstack Developer",
        company: "PT. FTS Automotive Indonesia",
        jobdesk: [
            "Internal Applications: Spearheaded the development of Purchase Requisition and Production Monitoring systems using Spring Boot and React to replace inflexible legacy modules.",
            "Significant Efficiency: Achieved a 50% increase in operational efficiency by streamlining budgeting and inventory processes through structured, system-driven validation.",
            "DevOps Automation: Streamlined development operations by implementing GitLab CI/CD pipelines, resulting in a 30% reduction in deployment time.",
            "System Architecture: Engineered robust system architectures, implemented RESTful APIs, and designed PostgreSQL data models.",
        ],
        stack: ["Spring Boot", "React", "PostgreSQL", "GitLab CI/CD", "Docker"],
    },
    {
        year: "2025",
        title: "Fullstack Developer",
        company: "PT. Sinar Sukses Mandiri",
        jobdesk: [
            "Process Digitalization: Developed core modules using Spring Boot and Vue.js to digitalize manual recording processes, resulting in a 20% reduction in operational errors.",
            "Internal Control: Strengthened process transparency by designing and implementing an automated approval workflow system to ensure authorized critical actions.",
            "Performance Optimization: Optimized application performance by 10% through caching strategies, backend code refinement, and PostgreSQL query tuning.",
            "System Stability: Enhanced system stability by diagnosing and resolving full-stack bottlenecks across frontend, backend, and database layers using Betterstack.",
        ],
        stack: [
            "Spring Boot",
            "Vue.js",
            "PostgreSQL",
            "Betterstack",
            "Golang",
            "Docker",
        ],
    },
];
---

<div class="md:container mx-auto my-10">
    <div class="grid md:grid-cols-2 gap-10 justify-items-center content-center">
        <div>
            <div
                class="font-bold md:text-5xl text-2xl mb-5 text-center md:text-left"
            >
                Hi, I'm Putra. A Fullstack Developer building scalable web
                applications
            </div>
            <div class="md:text-xl text-lg font-mono text-center md:text-left">
                Passionate Fullstack Engineer dedicated to crafting clean code
                and efficient digital solutions. With expertise in Golang, Nuxt,
                and Spring Boot, I transform complex problems into elegant,
                user-centric software. Explore my latest projects and technical
                insights below.
            </div>
        </div>
        <div class="self-center bg-bone aspect-square relative">
            <div
                class="bg-base-200 absolute top-2 left-2 w-full h-full -z-10 rounded hover:top-5 hover:left-5 transition-all duration-300"
            >
            </div>
            <img
                src="https://i.pravatar.cc/300?img=12"
                alt="Hero"
                class="w-full h-full rounded z-10"
                loading="lazy"
            />
        </div>
    </div>
    <div class="mt-10 flex flex-wrap gap-4">
        <button
            onclick="my_modal_1.showModal()"
            class="btn btn-outline btn-primary btn-lg rounded-md ring-1 shadow-[6px_6px_0_0_rgba(0,0,0,0.2)]
               hover:shadow-[0_4px_0_0_rgba(0,0,0,0.2)]
               active:shadow-none active:translate-y-1.5
               transition-all duration-75"
        >
            <Icon name="material-symbols:cases" />
            Work Experience
        </button>
        <button
            onclick="my_modal_2.showModal()"
            class="btn btn-outline btn-primary btn-lg rounded-md ring-1 shadow-[6px_6px_0_0_rgba(0,0,0,0.2)]
               hover:shadow-[0_4px_0_0_rgba(0,0,0,0.2)]
               active:shadow-none active:translate-y-1.5
               transition-all duration-75"
        >
            <Icon name="material-symbols:mail" />
            Send Me a Message
        </button>
    </div>
    <div class="card shadow-sm mt-10 bg-base-200">
        <div class="card-body">
            <div
                class="card-title font-bold md:text-2xl flex items-center gap-2"
            >
                About Me
            </div>
            <div class="grid md:grid-cols-2 gap-4">
                <div class="md:text-lg font-mono">
                    I am a Fullstack Developer with over 3 years of professional
                    experience building scalable web applications. My expertise
                    lies in bridging the gap between complex backend logic and
                    intuitive frontend experiences. Currently, I specialize in
                    the Golang and Nuxt.js/Vue ecosystem, with a strong
                    background in Java (Spring Boot) and distributed messaging
                    systems like RabbitMQ. I thrive on solving architectural
                    challenges and am currently passionate about developing
                    comprehensive ERP (Enterprise Resource Planning) and WMS
                    (Warehouse Management System) solutions. My goal is to
                    transform intricate business requirements into clean,
                    maintainable, and high-performing code
                </div>
                <div class="grid md:grid-cols-2 gap-4">
                    {
                        skills.map((skill) => (
                            <div class="flex items-center gap-2">
                                <div class="card bg-base-100 shadow-sm min-h-56 relative">
                                    <div class="card-body z-10">
                                        <h2 class="card-title text-xl flex items-center gap-2">
                                            <Icon
                                                name={skill.icon}
                                                class="text-xl"
                                            />
                                            {skill.name}
                                        </h2>
                                        <p>{skill.description}</p>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="card bg-base-200 mt-10">
        <div class="card-body">
            <div
                class="card-title font-bold md:text-2xl flex items-center gap-2"
            >
                Skills
            </div>
            <SkillList />
        </div>
    </div>

    <dialog id="my_modal_1" class="modal">
        <div class="modal-box w-11/12 max-w-5xl">
            <form method="dialog">
                <button class="btn btn-circle btn-ghost absolute right-2 top-2">
                    <Icon name="material-symbols:close" />
                </button>
            </form>
            <h3 class="text-lg font-bold">Work Experience</h3>
            <Timeline items={timelines} />
        </div>
    </dialog>

    <dialog id="my_modal_2" class="modal">
        <div class="modal-box w-11/12 max-w-5xl">
            <form method="dialog">
                <button class="btn btn-circle btn-ghost absolute right-2 top-2">
                    <Icon name="material-symbols:close" />
                </button>
            </form>
            <h3 class="text-lg font-bold">Send Me a Message</h3>
            <form
                action="https://formspree.io/f/xojyqzoz"
                method="post"
                class="flex flex-col gap-2"
            >
                <label class="form-control w-full">
                    <div class="label">
                        <span class="label-text">Your email?</span>
                    </div>
                    <input
                        required
                        name="email"
                        type="email"
                        placeholder="youremail@domain.name"
                        class="input input-bordered w-full"
                    />
                </label>
                <label class="form-control w-full">
                    <div class="label">
                        <span class="label-text">Your message</span>
                    </div>
                    <textarea
                        required
                        name="message"
                        placeholder="Type here"
                        rows={5}
                        class="textarea textarea-bordered w-full"></textarea>
                </label>
                <button type="submit" class="btn btn-primary">Send</button>
            </form>
        </div>
    </dialog>
</div>
