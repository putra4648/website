---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

type Props = HTMLAttributes<"a"> & {
  icon: string;
  url: string;
};

const { url, icon, class: className, ...props } = Astro.props;
const isActive = Astro.url.pathname.startsWith(url);
---

<a href={url} class={`mx-5 link ${isActive ? "font-bold" : ""}`} {...props}>
  <slot />
</a>
