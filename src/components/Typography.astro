---
type Props = {
  isEnglishWord: boolean;
  isBold: boolean;
  message: string;
};

const { isEnglishWord, isBold, message } = Astro.props;

const parseEnglishWord = () => {
  if (isEnglishWord && isBold) {
    return "italic font-bold";
  }

  if (isEnglishWord) {
    return "italic";
  }

  if (isBold) {
    return "font-bold";
  }
  return "";
};
---

<span class={`${parseEnglishWord()} `}>
  {message}
</span>
