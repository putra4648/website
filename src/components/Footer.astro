---
import { Icon } from "astro-icon/components";

const today = new Date();
const links = [
  {
    icon: "cib:github",
    to: "https://github.com/putra4648",
  },
  {
    icon: "cib:discord",
    to: "https://discord.com/users/1414837624257904741",
  },
];
---

<footer
  class="footer footer-horizontal footer-center text-base-content rounded p-10"
>
  <nav>
    <div class="grid grid-flow-col gap-3">
      {
        links.map((link) => {
          return (
            <a href={link.to} class="link" target="_blank">
              <Icon name={link.icon} class="text-3xl" />
            </a>
          );
        })
      }
    </div>
  </nav>
  <aside>
    <p>Copyright © {today.getFullYear()} - Putra</p>
  </aside>
</footer>
