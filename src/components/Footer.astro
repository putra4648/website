---
import { Icon } from "astro-icon/components";

const today = new Date();

const links = [
  {
    icon: "cib:rss",
    name: "RSS",
    href: "/resume",
  },
  {
    icon: "cib:github",
    name: "GitHub",
    href: "https://github.com/putra4648",
  },
  {
    icon: "cib:discord",
    name: "Discord",
    href: "https://discord.com/users/1414837624257904741",
  },
];
---

<footer class="footer footer-horizontal footer-center p-5">
  <div class="flex gap-4">
    {
      links.map((link) => {
        return (
          <a href={link.href} class="link flex items-center gap-2">
            <Icon name={link.icon} />
            {link.name}
          </a>
        );
      })
    }
  </div>

  <aside>
    <a href="https://github.com/putra4648/website" class="link">Source</a>
    <p>© 2022 - {today.getFullYear()} Putra</p>
  </aside>
</footer>
