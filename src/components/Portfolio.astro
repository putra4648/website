---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  portfolios: CollectionEntry<"portfolio">[];
};

const { portfolios } = Astro.props;
---

<div class="container mx-auto my-5">
  <div class="grid md:grid-cols-3 gap-4">
    {
      portfolios.map((item, index) => (
        <div
          class="card card-border bg-base-100  shadow-[6px_6px_0_0_rgba(0,0,0,0.2)]
               hover:shadow-[0_4px_0_0_rgba(0,0,0,0.2)]
               active:shadow-none active:translate-y-1.5
               transition-all duration-75"
        >
          <figure class="aspect-square ">
            {item.data.image && (
              <Image src={item.data.image} alt={item.data.title} />
            )}
          </figure>
          <div class="card-body">
            <h2 class="card-title flex justify-between">
              {item.data.title}
              <span>{item.data.year}</span>
            </h2>
            <p>{item.data.description.join(". ")}</p>
            <div class="card-actions justify-end">
              <a href={`/portfolio/${item.id}`} class="btn btn-primary">
                Preview
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>
