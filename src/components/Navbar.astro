---
import { SITE_TITLE } from "../consts";
import {
  getIntlayer,
  getLocaleFromPath,
  getLocalizedUrl,
  type LocalesValues,
} from "intlayer";
import NavbarLink from "./NavbarLink.astro";
import LanguagePicker from "./LanguagePicker.astro";

const lang = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const t = getIntlayer("app", lang);
const translatePath = (path: string) => getLocalizedUrl(path, lang);


const mapUrl = (url: string) => {
  return translatePath(url.startsWith("#") ? "#" + url : url);
}
---

<div
  class="container mx-auto card bg-base-100 mt-5 shadow-[6px_6px_0_0_rgba(0,0,0,0.2)]
               transition-all duration-75"
>
  <header class="sticky top-0 navbar shadow-sm px-3 z-1">
    <div class="navbar-start">
      <div class="text-md font-bold">
        <a href="/">{SITE_TITLE}</a>
      </div>
    </div>
    <div class="hidden md:flex navbar-end">
      <LanguagePicker />
      <NavbarLink
        icon="material-symbols:home"
        class="mx-2"
        href={mapUrl("/")}>{t.nav.home}</NavbarLink
      >
      <NavbarLink
        class="mx-2"
        icon="material-symbols:folder-code"
        href={mapUrl("#resume")}>{t.nav.resume}</NavbarLink
      >
      <NavbarLink class="mx-2" icon="material-symbols:book" href={"/guestbook"}
        >{t.nav.guestbook}</NavbarLink
      >
      <NavbarLink
        icon="material-symbols:globe"
        class="mx-2"
        href={mapUrl("/blog")}>{t.nav.blog}</NavbarLink
      >
    </div>
    <div class="navbar-end md:hidden">
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost btn-circle">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h7"></path>
          </svg>
        </div>
        <ul
          tabindex="-1"
          class="menu menu-lg dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow"
        >
          <li><a href={mapUrl("/")}>{t.nav.home}</a></li>
          <li><a href={mapUrl("#resume")}>{t.nav.resume}</a></li>
          <li><a href={mapUrl("guestbook")}>{t.nav.guestbook}</a></li>
          <li><a href={mapUrl("/blog")}>{t.nav.blog}</a></li>
          <li>
            <LanguagePicker />
          </li>
        </ul>
      </div>
    </div>
  </header>
</div>
