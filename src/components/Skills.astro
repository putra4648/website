---
import { Icon } from "astro-icon/components";

const skill = {
    programmings: ["Javascript", "Typescript", "Bash", "Java", "Dart", "Go"],
    devtools: [
        "Git",
        "Prometheus",
        "Grafana",
        "Jira",
        "Notion",
        "Flyway",
        "Excalidraw",
    ],
    databases: ["Postgres", "Redis", "MongoDB"],
    frontend: ["React", "Vue", "Flutter", "Nuxt"],
    backend: ["Springboot", "Quarkus", "Golang"],
    infrastructures: [
        "Sonarqube",
        "Linux",
        "Docker",
        "Rabbit MQ",
        "GitHub Actions",
        "Nginx",
    ],
    integrations: [
        "Keycloak",
        "OAuth2",
        "JWT",
        "Websocket",
        "Firebase",
        "Supabase",
    ],
    softskills: [
        "Teamwork",
        "Communication",
        "Problem Solving",
        "Adaptability",
    ],
};
const { id } = Astro.props;
---

<div class="card bg-base-200 mt-10" id={id}>
    <div class="card-body">
        <div class="card-title font-bold flex items-center gap-2">Skills</div>
        <div class="grid md:grid-cols-4 gap-3">
            {
                Object.entries(skill).map(([key, value]) => (
                    <div>
                        <p class="font-bold text-md mb-2">
                            {key.charAt(0).toUpperCase() + key.slice(1)}
                        </p>
                        {value.map((v, i) => (
                            <span >
                                {v}{" "}
                                {i !== value.length - 1 ? (
                                    <span class="mx-1">&middot;</span>
                                ) : (
                                    ""
                                )}
                            </span>
                        ))}
                    </div>
                ))
            }
        </div>
    </div>
</div>
