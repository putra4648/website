---
import { Icon } from "astro-icon/components";

const skill = {
    programmings: ["Javascript", "Typescript", "Bash", "Java", "Dart", "Go"],
    devtools: [
        "Git",
        "Prometheus",
        "Grafana",
        "Jira",
        "Notion",
        "Flyway",
        "Excalidraw",
    ],
    databases: ["Postgres", "Redis", "MongoDB"],
    frontend: ["React", "Vue", "Flutter", "Nuxt"],
    backend: ["Springboot", "Quarkus", "Golang"],
    infrastructures: [
        "Sonarqube",
        "Linux",
        "Docker",
        "Rabbit MQ",
        "GitHub Actions",
        "Nginx",
    ],
    integrations: [
        "Keycloak",
        "OAuth2",
        "JWT",
        "Websocket",
        "Firebase",
        "Supabase",
    ],
    softskills: [
        "Teamwork",
        "Communication",
        "Problem Solving",
        "Adaptability",
    ],
};
const mapIcons = (key: string) => {
    switch (key) {
        case "programmings":
            return "material-symbols:code";
        case "devtools":
            return "material-symbols:code";
        case "databases":
            return "material-symbols:database";
        case "frontend":
            return "material-symbols:web";
        case "backend":
            return "material-symbols:computer";
        case "infrastructures":
            return "material-symbols:cloud";
        case "integrations":
            return "material-symbols:link";
        case "softskills":
            return "material-symbols:article-person";
    }
};
const { id } = Astro.props;
---

<div class="card bg-base-200 mt-10" id={id}>
    <div class="card-body">
        <div class="card-title font-bold flex items-center gap-2">Skills</div>
        <div class="grid md:grid-cols-4 gap-3">
            {
                Object.entries(skill).map(([key, value]) => (

                    <div class="breadcrumbs text-sm p-0">
                        <ul>
                            <li class="font-bold no-underline">{key}</li>
                            {value.map((i) => (
                                <li class="badge badge-soft rounded-md">{i}</li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
</div>
