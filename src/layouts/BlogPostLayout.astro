---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import { Icon } from "astro-icon/components";
import Layout from "./Layout.astro";
import { getIntlayer, getLocaleFromPath, type LocalesValues } from "intlayer";

interface Props {
  // Ambil semua data dari skema Zod
  post: CollectionEntry<"blog">["data"];
  // Tambahkan property minutesRead secara manual di sini
  minutesRead: string;
  lastModified: string;
}

const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const labels = getIntlayer("blog", locale);
const slug = Astro.params.slug ?? Astro.url.pathname.split("/").filter(Boolean).pop()!;
const article = (labels.articles as Record<string, { title: string; description: string; tags: string[] }>)[slug];
const { pubDate, updatedDate } = Astro.props.post;
const { minutesRead, lastModified } = Astro.props;
---

<html>
  <body>
    <Layout title={article.title} description={article.description}>
      <main class="max-w-4/5 mx-auto prose my-3">
        <a role="button" class="btn btn-ghost btn-lg" href={locale === "en" ? "/blog" : `/${locale}/blog`}>
          <Icon name="material-symbols:arrow-back" />
          {labels.actions.back}
        </a>
        <div class="">
          <div class="">
            <div>
              <p>{minutesRead}</p>
              <div class="date">
                <FormattedDate date={pubDate} />
                {
                  updatedDate && (
                    <div class="last-updated-on">
                      {labels.metadata.updated} <FormattedDate date={updatedDate} />
                    </div>
                  )
                }
              </div>
              <h1>{article.title}</h1>
              {article.description}
              <div class="flex flex-wrap gap-1 my-2">
                {article.tags.map((tag) => <div class={`badge badge-soft`}>{tag}</div>)}
              </div>
              <p class="text-end">Last Edited {lastModified}</p>
              <hr />
            </div>
          </div>
        </div>
        <div>
          <slot />
          <div id="disqus_thread"></div>
          <script is:inline>
            /**
             *  RECOMMENDED CONFIGURATION VARIABLES: EDIT AND UNCOMMENT THE SECTION BELOW TO INSERT DYNAMIC VALUES FROM YOUR PLATFORM OR CMS.
             *  LEARN WHY DEFINING THESE VARIABLES IS IMPORTANT: https://disqus.com/admin/universalcode/#configuration-variables    */

            // Patch for Disqus OKLCH issue
            // Disqus script crashes when it encounters oklch() colors during theme detection
            (function () {
              const _getComputedStyle = window.getComputedStyle;
              window.getComputedStyle = function (el, pseudo) {
                const style = _getComputedStyle(el, pseudo);
                return new Proxy(style, {
                  get(target, prop) {
                    const value = target[prop];
                    if (typeof value === "string" && value.includes("oklch")) {
                      // Return a safe fallback that Disqus can parse
                      return "rgb(255, 255, 255)";
                    }
                    if (prop === "getPropertyValue") {
                      return (propertyName) => {
                        const val = target.getPropertyValue(propertyName);
                        return typeof val === "string" && val.includes("oklch")
                          ? "rgb(255, 255, 255)"
                          : val;
                      };
                    }
                    return typeof value === "function"
                      ? value.bind(target)
                      : value;
                  },
                });
              };
            })();

            var disqus_config = function () {
              this.page.url = window.location.href; // Better to use dynamic URL
              this.page.identifier = window.location.pathname; // Unique identifier
            };

            (function () {
              // DON'T EDIT BELOW THIS LINE
              var d = document,
                s = d.createElement("script");
              s.src = "https://putracoderz.disqus.com/embed.js";
              s.setAttribute("data-timestamp", +new Date());
              (d.head || d.body).appendChild(s);
            })();
          </script>
        </div>
        <!-- <Footer /> -->
      </main>
    </Layout>
  </body>
</html>
