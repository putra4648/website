---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import { Icon } from "astro-icon/components";
import Layout from "./Layout.astro";
import { Image } from "astro:assets";
import { getIntlayer, getLocaleFromPath, type LocalesValues } from "intlayer";

interface Props {
    post: CollectionEntry<"portfolio">["data"];
    id: string;
}

const { post } = Astro.props;
const { year, image, stack } = post;
const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const { actions, articles, sections } = getIntlayer("portfolio", locale);
type PortfolioArticle = { title: string; description: string };
const slug = Astro.props.id;
const article = (articles as unknown as Record<string, PortfolioArticle>)[slug];
---

<html>
    <body>
        <Layout title={article.title} description={article.description}>
            <main class="max-w-4/5 mx-auto prose my-3">
                <a role="button" class="btn btn-ghost btn-lg" href={locale === "en" ? "/portfolio" : `/${locale}/portfolio`}>
                    <Icon name="material-symbols:arrow-back" />
                    {actions.back}
                </a>
                <div class="">
                    <h1>{article.title}</h1>
                    <div>{year}</div>
                    <div class="flex flex-wrap gap-2">
                        {
                            stack.map((s) => (
                                <div class="badge badge-secondary">{s}</div>
                            ))
                        }
                    </div>
                    <div>
                        <p>{article.description}</p>
                        <hr />
                    </div>

                    {
                        image && (
                            <div>
                                <h2>{sections.preview}</h2>
                                <Image
                                    src={image}
                                    alt={article.title}
                                    width={image.width}
                                    height={image.height}
                                />
                            </div>
                        )
                    }
                </div>
                <div>
                    <slot />
                </div>
            </main>
        </Layout>
    </body>
</html>
