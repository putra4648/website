---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import { Icon } from "astro-icon/components";
import Layout from "./Layout.astro";
import { getIntlayer, getLocaleFromPath, type LocalesValues } from "intlayer";

interface Props {
  // Ambil semua data dari skema Zod
  article: CollectionEntry<"article">["data"];
  // Tambahkan property minutesRead secara manual di sini
  minutesRead: string;
  lastModified: string;
}

const locale = getLocaleFromPath(Astro.url.pathname) as LocalesValues;
const labels = getIntlayer("article", locale);
const slug =
  Astro.params.slug ?? Astro.url.pathname.split("/").filter(Boolean).pop()!;
const article = (
  labels.articles as Record<
    string,
    { title: string; description: string; tags: string[] }
  >
)[slug];
const { pubDate, updatedDate } = Astro.props.article;
const { minutesRead, lastModified } = Astro.props;
---

<html>
  <body>
    <Layout title={article.title} description={article.description}>
      <main class="max-w-4/5 mx-auto prose my-3">
        <a
          role="button"
          class="btn btn-ghost btn-lg"
          href={`/${locale}/article`}
        >
          <Icon name="material-symbols:arrow-back" />
          {labels.actions.back}
        </a>
        <div class="">
          <div class="">
            <div>
              <p>{minutesRead}</p>
              <div class="date">
                <FormattedDate date={pubDate} />
                {
                  updatedDate && (
                    <div class="last-updated-on">
                      {labels.metadata.updated}{" "}
                      <FormattedDate date={updatedDate} />
                    </div>
                  )
                }
              </div>
              <h1>{article.title}</h1>
              {article.description}
              <div class="flex flex-wrap gap-1 my-2">
                {
                  article.tags.map((tag) => (
                    <div class={`badge badge-soft`}>{tag}</div>
                  ))
                }
              </div>
              <p>Last Edited {lastModified}</p>
              <hr />
            </div>
          </div>
        </div>
        <div>
          <slot />
          <script
            src="https://giscus.app/client.js"
            data-repo="putra4648/website"
            data-repo-id="R_kgDON7ddHw"
            data-category="Show and tell"
            data-category-id="DIC_kwDON7ddH84DI5rM"
            data-mapping="url"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="preferred_color_scheme"
            data-lang="en"
            crossorigin="anonymous"
            async></script>
        </div>
        <!-- <Footer /> -->
      </main>
    </Layout>
  </body>
</html>
