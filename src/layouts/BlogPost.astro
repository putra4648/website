---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getLangFromUrl, useTranslatedPath } from "../i18n/utils";
import { randomizeTagColors } from "../utils/tag";

interface Props {
  // Ambil semua data dari skema Zod
  post: CollectionEntry<"blog">["data"];
  // Tambahkan property minutesRead secara manual di sini
  minutesRead: string;
  lastModified: string;
}

const { title, tags, pubDate, updatedDate, description } = Astro.props.post;
const { minutesRead, lastModified } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<html lang={lang}>
  <head>
    <BaseHead title={title} description={description.join(". ")} />
  </head>

  <body>
    <Header />
    <main class="max-w-3/5 mx-auto prose my-3">
      <a class="btn btn-ghost" href={translatePath("/blog")}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
        </svg>
        Back to Blog
      </a>
      <div class="">
        <div class="">
          <div>
            <!-- <p>{frontmatter.lastModified}</p> -->
            <p>{minutesRead}</p>
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            {description.map((d) => <small>{d}</small>)}
            <div class="flex gap-1 my-2">
              {
                tags.map((t) => (
                  <div class={`badge badge-outline ${randomizeTagColors(t)}`}>
                    {t}
                  </div>
                ))
              }
            </div>
            <p class="text-end">Last Edited {lastModified}</p>
            <hr />
          </div>
        </div>
      </div>
      <div>
        <slot />
      </div>
      <!-- <Footer /> -->
    </main>
  </body>
</html>
